BEGIN:VEVENT
UID:st-vincent-day@wine-holidays
DTSTAMP:20260818T000000Z
DTSTART;VALUE=DATE:20260122
DTEND;VALUE=DATE:20260123
RRULE:FREQ=YEARLY;BYMONTH=1;BYMONTHDAY=22
SUMMARY:St Vincent's Day (Winemakers' Patron Saint)
DESCRIPTION:Feast of St Vincent\, patron saint of winegrowers. Marked as Vi
 ncencovo in Slovenia and Croatia\, and by the Saint-Vincent Tournante proc
 ession that rotates between villages in Burgundy.\n\nRegion: France\, Slov
 enia\, Croatia\n\nSource: https://winetastingljubljana.com/blog/6-importan
 t-wine-holidays-slovenia/
CATEGORIES:tradition
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:port-wine-day-january@wine-holidays
DTSTAMP:20260818T000000Z
DTSTART;VALUE=DATE:20260127
DTEND;VALUE=DATE:20260128
RRULE:FREQ=YEARLY;BYMONTH=1;BYMONTHDAY=27
SUMMARY:International Port Wine Day
DESCRIPTION:A day for Portugal's fortified wine from the Douro. Note there 
 are two competing Port days — this one and 10 September. Both are in thi
 s calendar.\n\nRegion: Portugal\n\nHeads up: sources disagree on this date
  — worth checking before you plan around it.\n\nSource: https://wineinte
 rnationalassociation.org/wine-days-calendar-2026/
CATEGORIES:style
TRANSP:TRANSPARENT
END:VEVENT
